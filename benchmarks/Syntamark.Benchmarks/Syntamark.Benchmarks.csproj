<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SyntamarkAssembly Condition="'$(SyntamarkAssembly)' == ''">../../src/Syntamark/bin/Release/net10.0/Syntamark.dll</SyntamarkAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Syntamark" HintPath="$(SyntamarkAssembly)" />
    <PackageReference Include="YamlDotNet" Version="[18.1.0]" />
    <Compile Include="../../tests/Syntamark.Portability/QueryChecks.cs" Link="QueryChecks.cs" />
  </ItemGroup>
</Project>
