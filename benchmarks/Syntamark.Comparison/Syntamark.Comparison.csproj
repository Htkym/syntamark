<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SyntamarkAssembly Condition="'$(SyntamarkAssembly)' == ''">../../.local/comparison-benchmark-current/Syntamark.dll</SyntamarkAssembly>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SyntamarkAnalysis)' == 'true'">
    <DefineConstants>$(DefineConstants);SYNTAMARK_ANALYSIS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Syntamark" HintPath="$(SyntamarkAssembly)" />
    <PackageReference Include="YamlDotNet" Version="[18.1.0]" />
    <PackageReference Include="Markdig" Version="[1.5.1]" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="[4.14.0]" />
  </ItemGroup>
</Project>
