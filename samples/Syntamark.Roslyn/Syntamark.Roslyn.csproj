<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <SyntamarkIncludeSource Condition="'$(SyntamarkCandidateMode)' == 'true'">true</SyntamarkIncludeSource>
    <SyntamarkSourceVersion Condition="'$(SyntamarkSourceVersion)' == ''">2.0.0-preview.20261113</SyntamarkSourceVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- This non-shipping canary declares only its tested C# host and has no analyzer release history. -->
    <NoWarn>$(NoWarn);RS1004;RS2008</NoWarn>
    <NuGetLockFilePath Condition="'$(SyntamarkCandidateMode)' == 'true'">obj/candidate.packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Condition="'$(SyntamarkCandidateMode)' == 'true'" Include="Syntamark.Source" Version="[$(SyntamarkSourceVersion)]" PrivateAssets="all" IncludeAssets="build" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="[4.14.0]" PrivateAssets="all" />
    <Compile Include="../../src/Syntamark/Portable/**/*.cs" Link="Portable/%(RecursiveDir)%(Filename)%(Extension)" Condition="'$(SyntamarkCandidateMode)' != 'true'" />
  </ItemGroup>
</Project>
