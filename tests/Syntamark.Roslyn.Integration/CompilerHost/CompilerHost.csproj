<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <UseSharedCompilation>false</UseSharedCompilation>
    <ErrorLog Condition="'$(CanaryErrorLog)' != ''">$(CanaryErrorLog),version=2.1</ErrorLog>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Include="../../../samples/Syntamark.Roslyn/bin/Release/netstandard2.0/Syntamark.Roslyn.dll" />
    <Analyzer Include="../../../samples/Syntamark.Roslyn/bin/Release/netstandard2.0/YamlDotNet.dll" />
    <AdditionalFiles Include="$(CanaryMarkdown)" Condition="'$(CanaryMarkdown)' != ''" />
    <CompilerVisibleProperty Include="SyntamarkMaxScanUnits" />
  </ItemGroup>
</Project>
